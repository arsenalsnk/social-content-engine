# Application
NODE_ENV=development
CRON_SCHEDULE=*/15 * * * *
LOG_LEVEL=INFO

# LLM providers (comma-separated fallback order: deepseek, gemini, openai)
LLM_PROVIDERS=deepseek,gemini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 1 = one post per cron run; 0 = post all eligible unposted articles this run
PIPELINE_BATCH_SIZE=0
# today = only articles published today (timezone below); hours = rolling window
ARTICLE_FILTER_MODE=today
ARTICLE_TIMEZONE=Asia/Bangkok
MAX_ARTICLE_AGE_HOURS=48

# Firebase Admin SDK (Node.js backend — NOT Web SDK apiKey/appId)
# 1. Firebase Console → Project Settings → Service accounts
# 2. Generate new private key → save as serviceAccountKey.json
FIREBASE_PROJECT_ID=social-content-engine-c5fb5
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Alternative: inline credentials (e.g. Railway / VPS)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@social-content-engine-c5fb5.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Facebook Graph API
# Setup:
# 1. https://developers.facebook.com → Create App (Business)
# 2. Add your Facebook Page to the app
# 3. Graph API Explorer → Generate token with scopes:
#    pages_manage_posts, pages_read_engagement, pages_show_list,
#    instagram_basic, instagram_manage_insights
# 4. GET /me/accounts → copy Page ID + Page Access Token
# 5. Paste below (User Token or Page Token both work — app resolves Page Token automatically)
# 6. Link Instagram Business account to your Facebook Page in Meta Business Suite
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_RETRY_ATTEMPTS=3

# Instagram (Business Discovery via Graph API)
INSTAGRAM_ENABLED=true
INSTAGRAM_TARGET_USERNAME=fabriziorom
INSTAGRAM_FETCH_LIMIT=12
INSTAGRAM_SOURCE_NAME=Instagram @fabriziorom
# Comma-separated Arsenal keywords; leave empty to use built-in defaults
INSTAGRAM_KEYWORDS=arsenal,gunners,afc,arteta,here we go

# RSS Sources (JSON array)
RSS_SOURCES=[{"id":"arsenal-bbc","name":"Arsenal BBC Sport","url":"https://feeds.bbci.co.uk/sport/football/teams/arsenal/rss.xml","category":"official","enabled":true},{"id":"arsenal-guardian","name":"Arsenal The Guardian","url":"https://www.theguardian.com/football/arsenal/rss","category":"football","enabled":true},{"id":"arsenal-football-london","name":"Football London Arsenal","url":"https://www.football.london/all-about/arsenal?service=rss","category":"transfer","enabled":true}]

# Image output
IMAGE_OUTPUT_DIR=./output/images

# Stock images (recommended — avoids news copyright issues)
USE_NEWS_IMAGES=false
PEXELS_API_KEY=
PEXELS_DEFAULT_QUERY=Arsenal football stadium
